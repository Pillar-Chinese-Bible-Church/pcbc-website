{
  "name": "pillar-cbc-website",
  "private": true,
  "type": "module",
  "description": "\u67f1\u77f3\u534e\u4eba\u5723\u7ecf\u6559\u4f1a Pillar Chinese Bible Church website",
  "scripts": {
    "dev": "eleventy --serve --port 8080",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
