---
pagination:
  data: langs
  size: 1
  alias: L
permalink: "{{ L.prefix }}/contact/index.html"
pagePath: "/contact/"
layout: base.njk
eleventyComputed:
  pageDescription: "{{ contact[L.code].intro }}"
  pageTitle: "{{ contact[L.code].title }} · {{ site.name | t(L.code) }}"
---
{%- set c = L.code -%}
{%- set f = contact[c] -%}
<main id="main" class="contact-page">
  <header class="contact-heading page-heading">
    <div class="wrap">
      <h1>{{ f.title }}</h1>
      <p>{{ f.intro }}</p>
    </div>
  </header>
  <div class="contact-layout wrap">
    <section class="contact-form-section" aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading">{{ f.formTitle }}</h2>
      <p class="contact-intro">{{ f.formIntro }}</p>
      <form id="contact-form" method="post" action="/api/contact" data-language="{{ c }}" data-sending="{{ f.sending }}" data-success="{{ f.success }}" data-unavailable="{{ f.unavailable }}" data-error="{{ f.error }}" data-verification="{{ f.verification }}" data-retry-verification="{{ f.retryVerification }}" data-verifying="{{ f.verifying }}" data-verified-label="{{ f.verifiedLabel }}" data-verified="{{ f.verified }}" data-verification-retry="{{ f.verificationRetry }}" data-verification-expired="{{ f.verificationExpired }}" data-rate-limited="{{ f.rateLimited }}" aria-labelledby="contact-form-heading">
        <p class="contact-required">{{ f.required }}</p>
        <p class="contact-context" hidden>{{ f.regarding }}: <span id="contact-context"></span></p>
        <div class="contact-fields">
          <div class="contact-field">
            <label for="contact-name">{{ f.name }}</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="120" required>
          </div>
          <div class="contact-field">
            <label for="contact-email">{{ f.email }}</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required>
          </div>
        </div>
        <div class="contact-field">
          <label for="contact-topic">{{ f.topic }}</label>
          <select id="contact-topic" name="topic" required>
            <option value="">{{ f.chooseTopic }}</option>
            {% for value, label in f.topics %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div class="contact-field">
          <label for="contact-message">{{ f.message }}</label>
          <textarea id="contact-message" name="message" rows="7" minlength="10" maxlength="4000" required aria-describedby="message-hint"></textarea>
          <div class="contact-message-hint"><small id="message-hint">{{ f.messageHint }}</small><span id="message-count" aria-hidden="true">0 / 4,000</span></div>
        </div>
        <div class="contact-trap" hidden aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
        <button id="contact-verify" class="btn contact-verify" type="button" aria-describedby="contact-status">{{ f.verify }}</button>
        <div id="contact-verification"></div>
        <p id="contact-status" class="contact-status" role="status" aria-live="polite" tabindex="-1">{{ f.verification }}</p>
        <noscript><p>{{ f.noScript }}</p></noscript>
        <button class="btn dark contact-send" type="submit" aria-describedby="contact-status" disabled>{{ f.send }}</button>
      </form>
    </section>
    <aside class="contact-sidebar" aria-label="{{ f.emailTitle }}">
      <section class="contact-email-block">
        <h2>{{ f.emailTitle }}</h2>
        <p>{{ f.emailIntro }}</p>
        <a class="contact-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a class="btn dark" href="mailto:{{ site.email }}">{{ f.emailAction }} ↗</a>
      </section>
      <section class="contact-visit-block">
        <h2>{{ f.visitTitle }}</h2>
        <p class="contact-service-time">{{ site.sunday.time | t(c) }}</p>
        <p>{{ site.sunday.note | t(c) }}</p>
        <h3>{{ f.address }}</h3>
        <p>{{ site.address }}</p>
        <a href="{{ site.map_link }}" target="_blank" rel="noopener">{{ f.directions }} ↗</a>
      </section>
    </aside>
    <a class="contact-back" href="{{ L.prefix }}/">{{ f.home }}</a>
  </div>
</main>
<script src="/assets/contact.js?v={{ assets.version }}" defer></script>
