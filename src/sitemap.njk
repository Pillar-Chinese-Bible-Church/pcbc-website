---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for locale in langs %}
  {%- for path in ["/", "/about/", "/teach/", "/contact/", "/giving/", "/sermons/", "/bulletin/"] %}
  <url><loc>{{ (locale.prefix + path) | absoluteUrl(deployment.url) }}</loc></url>
  {%- endfor %}
  {%- for entry in sermonData.items %}
  <url><loc>{{ (locale.prefix + "/sermons/" + entry.date + "/") | absoluteUrl(deployment.url) }}</loc></url>
  {% if entry.bulletin %}<url><loc>{{ (locale.prefix + "/sermons/" + entry.date + "/bulletin/") | absoluteUrl(deployment.url) }}</loc></url>{% endif %}
  {%- endfor %}
  {%- for event in eventData.items %}{% if not event.sample %}
  <url><loc>{{ (locale.prefix + "/events/" + event.slug + "/") | absoluteUrl(deployment.url) }}</loc></url>
  {%- endif %}{%- endfor %}
{%- endfor %}
</urlset>
