{#- Shared page frame: header, language switch, footer. Pages set `L` (language) and `pagePath` ("/" or "/teach/"). -#}
{%- set L = eventPage.language if eventPage else L -%}
{%- set u = ui[L.code] -%}
{%- set home = L.prefix + "/" -%}
<!doctype html>
<html lang="{{ L.code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ (L.prefix + pagePath) | absoluteUrl(deployment.url) }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ (L.prefix + pagePath) | absoluteUrl(deployment.url) }}">
<meta property="og:site_name" content="{{ site.name | t(L.code) }}">
<meta name="twitter:card" content="summary">
{% if eventPage and eventPage.event.sample %}<meta name="robots" content="noindex, nofollow">{% endif %}
{%- for l in langs %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ (l.prefix + pagePath) | absoluteUrl(deployment.url) }}">
{%- endfor %}
<link rel="icon" href="/images/logo-pillar.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ L.font }}:wght@300;400;500;600&amp;display=swap">
<link rel="stylesheet" href="/assets/site.css">
<script src="/assets/lang.js"></script>
</head>
<body>
<a class="skip-link" href="#main">{{ u.skip }}</a>
<header class="top">
  <div class="wrap">
    <a class="logo" href="{{ home }}">
      {% logo "mark", 27, 40 %}
      <span><b>{{ site.name | t(L.code) }}</b><small>{{ site.name.en if L.code != "en" else site.name.zh }}</small></span>
    </a>
    <button class="menu" id="menuBtn" type="button" aria-expanded="false" aria-controls="nav" aria-label="{{ u.menu }}" data-open="{{ u.close }}" data-closed="{{ u.menu }}"><span class="menu-icon" aria-hidden="true"></span></button>
    <nav class="nav" id="nav">
      <a href="{{ home }}#sunday">{{ u.nav.sunday }}</a>
      {% if eventData.upcoming.length %}<a href="{{ home }}#events" data-events-nav data-last-event-end="{{ eventData.latestEnd }}">{{ u.nav.events }}</a>{% endif %}
      <a href="{{ home }}#groups">{{ u.nav.groups }}</a>
      <a href="{{ home }}#about">{{ u.nav.life }}</a>
      <a href="{{ L.prefix }}/teach/">{{ u.nav.beliefs }}</a>
      <a href="{{ L.prefix }}/giving/"{% if pagePath == '/giving/' %} aria-current="page"{% endif %}>{{ u.nav.giving }}</a>
      <a href="{{ L.prefix }}/contact/"{% if pagePath == '/contact/' %} aria-current="page"{% endif %}>{{ u.nav.contact }}</a>
      <div class="langs" role="group" aria-label="{{ u.langGroup }}">
        {%- for l in langs %}<a href="{{ l.prefix }}{{ pagePath }}" lang="{{ l.code }}" data-lang="{{ l.code }}"{% if l.code == L.code %} aria-current="true"{% endif %}>{{ l.label }}</a>{% endfor -%}
      </div>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer id="contact">
  <div class="wrap">
    <div>
      <div class="fname">{% logo "flogo", 22, 32 %}<h4>{{ site.name | t(L.code) }}</h4></div>
      <p>{{ site.name.en if L.code != "en" else site.name.zh }}<br>{{ site.address }}</p>
    </div>
    <div>
      <h4>{{ u.footerTimes }}</h4>
      <p>{{ u.sundayWorship }}{{ u.sep }}{{ site.sunday.time | t(L.code) }}
      {%- for g in homepage.week.gatherings %}<br>{{ g.name | t(L.code) }}{{ u.sep }}{{ g.time | t(L.code) }}{% endfor %}</p>
    </div>
    <div>
      <h4><a href="{{ L.prefix }}/contact/">{{ u.footerContact }}</a></h4>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p><a href="{{ L.prefix }}/giving/">{{ u.nav.giving }}</a></p>
      <div class="social">
        {%- if site.links.wechat %}<a href="{{ site.links.wechat }}">{{ u.wechat }}</a>{% endif %}
        {%- if site.links.youtube %}<a href="{{ site.links.youtube }}">YouTube</a>{% endif %}
        {%- if site.links.xiaohongshu %}<a href="{{ site.links.xiaohongshu }}">{{ u.xiaohongshu }}</a>{% endif -%}
      </div>
    </div>
    {%- if site.footer_note | t(L.code) %}
    <p class="credit">{{ site.footer_note | t(L.code) }}</p>
    {%- endif %}
  </div>
</footer>
<script src="/assets/site.js"></script>
</body>
</html>
