{%- set c = L.code -%}
{%- set h = homepage -%}
{%- set u = ui[c] -%}
<main id="main">
  <section class="hero">
    <img class="hero-img" src="{{ h.hero.image }}" alt="{{ h.hero.image_alt | t(c) }}" loading="eager" fetchpriority="high">
    <div class="wrap">
      <h1>{{ h.hero.title | tt(c) | safe }}</h1>
      <p>{{ h.hero.subtitle | t(c) }}</p>
      <div class="hero-actions">
        <a class="btn" href="#sunday">{{ h.hero.button | t(c) }}</a>
        {% if eventData.upcoming.length %}<a class="btn outline" href="#events" data-events-nav data-last-event-end="{{ eventData.latestEnd }}">{{ u.nav.events }} ↓</a>{% endif %}
        <a class="btn outline" href="{{ L.prefix }}/about/">{{ h.hero.about_button | t(c) }}</a>
      </div>
    </div>
  </section>

  <section class="band" id="sunday" aria-labelledby="sunday-heading">
    <div class="wrap sunday-wrap">
      <div class="sunday-overview">
        <div class="sunday-copy">
          {% if h.sunday.eyebrow | t(c) %}<p class="sunday-eyebrow">{{ h.sunday.eyebrow | t(c) }}</p>{% endif %}
          <h2 id="sunday-heading">{{ h.sunday.heading | t(c) }}</h2>
          {% if h.sunday.intro | t(c) %}<p class="sunday-intro">{{ h.sunday.intro | t(c) }}</p>{% endif %}
          <div class="sunday-facts">
            <div class="sunday-fact sunday-fact-time">
              <span class="sunday-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
              <div><p class="sunday-time">{{ site.sunday.time | t(c) }}</p><p class="sunday-note">{{ site.sunday.note | t(c) }}</p></div>
            </div>
            <div class="sunday-fact sunday-fact-location">
              <span class="sunday-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span>
              {% set addressParts = site.address.split(', ') %}
              <p class="sunday-address">{{ addressParts[0] }}{% if addressParts.length > 1 %}<br>{{ addressParts.slice(1).join(', ') }}{% endif %}</p>
            </div>
          </div>
          <div class="sunday-actions">
            <a class="btn dark" href="{{ site.map_link }}" target="_blank" rel="noopener">{{ u.events.directions }} <span aria-hidden="true">↗</span></a>
            <a class="sunday-contact" href="{{ L.prefix }}/contact/?topic=visit">{{ u.events.question }}</a>
          </div>
          <div class="sunday-resources">
            <p>{{ u.sundayResources }}</p>
            <div class="sunday-resource-links">
              {% if sd.current and sd.current.bulletin %}<a href="{{ sermonBase }}/bulletin/">{{ sermonUi[c].thisBulletin }}</a>{% endif %}
              <a href="{{ sermonBase }}/sermons/">{{ sermonUi[c].archive }}</a>
              {% if site.links.youtube %}<a href="{{ site.links.youtube }}" target="_blank" rel="noopener">{{ h.sunday.youtube_label | t(c) }} <span aria-hidden="true">↗</span></a>{% endif %}
            </div>
          </div>
        </div>
        <div class="sunday-photo"><img src="{{ h.sunday.image }}" alt="{{ h.sunday.image_alt | t(c) }}" sizes="(max-width: 820px) calc(100vw - 40px), (max-width: 1100px) 58vw, 620px"></div>
      </div>
    </div>
  </section>

  {% include "events.njk" %}

  <section class="week" id="groups">
    <div class="wrap">
    <h2>{{ h.week.heading | t(c) }}</h2>
    {%- if h.week.intro | t(c) %}
    <p class="intro">{{ h.week.intro | t(c) }}</p>
    {%- endif %}
    <div class="boxes">
      {%- for g in h.week.gatherings %}
      <div class="box">
        <h3>{{ g.name | t(c) }}</h3>
        {%- if g.time | t(c) %}<p><b>{{ u.time }}</b>{{ g.time | t(c) }}</p>{% endif %}
        {%- if g.place | t(c) %}<p><b>{{ u.place }}</b>{{ g.place | t(c) }}</p>{% endif %}
        {%- if g.topic | t(c) %}<p><b>{{ u.topic }}</b>{{ g.topic | t(c) }}</p>{% endif %}
        <a href="{{ L.prefix }}/contact/?topic=gatherings&amp;regarding={{ g.name | t(c) | urlencode }}" aria-label="{{ u.askAbout }} {{ g.name | t(c) }}">{{ u.more }}<span class="sr-only">: {{ g.name | t(c) }}</span></a>
      </div>
      {%- endfor %}
    </div>
    </div>
  </section>

  <section class="verse">
    <div class="wrap">
      <p class="v">{{ h.verse.text | tt(c) | safe }}</p>
      <p class="r">{{ h.verse.reference | t(c) }}</p>
      {%- if h.verse.note | t(c) %}
      <p class="n">{{ h.verse.note | t(c) }}</p>
      {%- endif %}
    </div>
  </section>

  <div class="strip" role="group" aria-label="{{ photos.label | t(c) }}" data-photo-strip>
    {%- for p in photos.strip %}
    <button class="photo-open" type="button" disabled aria-label="{{ u.photos.open }}: {{ p.alt | t(c) }}" aria-haspopup="dialog" aria-controls="photo-viewer">
      <img src="{{ p.image }}" alt="{{ p.alt | t(c) }}" sizes="(max-width: 640px) 240px, 320px" eleventy:widths="320,480,720,960,1600,2400">
      <span class="photo-expand" aria-hidden="true">⤢</span>
    </button>
    {%- endfor %}
  </div>
  <dialog class="photo-viewer" id="photo-viewer" aria-label="{{ photos.label | t(c) }}">
    <div class="photo-toolbar">
      <span data-photo-count aria-live="polite" aria-atomic="true"></span>
      <button type="button" data-photo-close autofocus aria-label="{{ u.close }}"><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    </div>
    <figure class="photo-figure">
      <div class="photo-stage" data-photo-stage></div>
    </figure>
    <div class="photo-navigation">
      <button type="button" data-photo-prev aria-label="{{ u.photos.previous }}">←</button>
      <button type="button" data-photo-next aria-label="{{ u.photos.next }}">→</button>
    </div>
  </dialog>

  <section class="values">
    <div class="wrap">
      <h2>{{ h.values.heading | t(c) }}</h2>
      <p class="intro">{{ h.values.mission | t(c) }}</p>
      <div class="vlist">
        {%- for v in values.items %}
        <div class="vitem"><span class="num">{{ loop.index }}</span><div><h3>{{ v.title | t(c) }}</h3><p>{{ v.summary | t(c) }}</p></div></div>
        {%- endfor %}
      </div>
      <p class="more"><a class="btn dark" href="{{ L.prefix }}/about/#core-values">{{ h.values.button | t(c) }}</a></p>
    </div>
  </section>
</main>
