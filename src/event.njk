---
pagination:
  data: eventPages
  size: 1
  alias: eventPage
permalink: "{{ eventPage.language.prefix }}/events/{{ eventPage.event.slug }}/index.html"
layout: base.njk
eleventyComputed:
  pagePath: "/events/{{ eventPage.event.slug }}/"
  pageTitle: "{{ eventPage.event.title | t(eventPage.language.code) }} · {{ site.name | t(eventPage.language.code) }}"
---
{%- set L = eventPage.language -%}
{%- set c = L.code -%}
{%- set u = ui[c] -%}
{%- set e = eventPage.event -%}
<main class="event-page wrap" id="main">
  <a class="back" href="{{ L.prefix }}/#events">{{ u.events.back }}</a>
  <header class="event-heading">
    {% if e.sample %}<p class="sample-label">{{ u.events.sample }}</p>{% endif %}
    <p class="event-ended" data-ended-notice="{{ e.end }}" hidden>{{ u.events.ended }}</p>
    <h1>{{ e.title | t(c) | escape }}</h1>
    <p>{{ e.summary | t(c) | escape }}</p>
  </header>
  <div class="event-layout">
    <aside class="event-info" aria-labelledby="event-info-heading">
      <h2 id="event-info-heading">{{ u.events.info }}</h2>
      <dl>
        <dt>{{ u.events.when }}</dt><dd><time datetime="{{ e.start }}">{{ e.start | eventDate(c) }} · {{ e.start | eventTime(c) }}</time><br>{{ u.events.until }} <time datetime="{{ e.end }}">{{ e.end | eventDate(c) }} · {{ e.end | eventTime(c) }}</time><br><small>{{ u.events.timezone }}</small></dd>
        <dt>{{ u.events.where }}</dt><dd>{{ e.location | t(c) | escape }}{% if e.address %}<br>{{ e.address }}{% endif %}</dd>
        <dt>{{ u.events.joining }}</dt><dd>{{ e.joining | t(c) | escape }}</dd>
      </dl>
      {% if e.map_url %}<p><a href="{{ e.map_url }}" target="_blank" rel="noopener">{{ u.events.directions }} ↗</a></p>{% endif %}
      {% if e.registration_url %}<a class="btn dark" data-event-end="{{ e.end }}" href="{{ e.registration_url }}" target="_blank" rel="noopener">{{ u.events.register }} ↗</a>{% endif %}
      <a class="event-question" href="{{ L.prefix }}/contact/?topic=events&amp;regarding={{ e.title | t(c) | urlencode }}">{{ u.events.question }}</a>
    </aside>
    <article class="event-description">
      {% if e.image %}<img src="{{ e.image }}" alt="{{ e.image_alt | t(c) | escape }}" sizes="(max-width: 760px) 100vw, 680px">{% endif %}
      <h2>{{ u.events.about }}</h2>
      <p>{{ e.details | tt(c) | safe }}</p>
    </article>
  </div>
</main>
